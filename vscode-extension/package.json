{
  "name": "claude-session-bridge-vscode",
  "displayName": "Claude Session Bridge",
  "description": "One-click guided handoff and verified backup for Claude Code VS Code sessions across accounts.",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "publisher": "ehk2509",
  "categories": [
    "Other"
  ],
  "keywords": [
    "Claude Code",
    "sessions",
    "handoff",
    "backup",
    "account switch"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.94.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:claudeSessionBridge.resume",
    "onCommand:claudeSessionBridge.backup",
    "onCommand:claudeSessionBridge.switchAccount",
    "onCommand:claudeSessionBridge.handoff",
    "onCommand:claudeSessionBridge.finishHandoff",
    "onCommand:claudeSessionBridge.quickHandoff",
    "onCommand:claudeSessionBridge.diagnose"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeSessionBridge.quickHandoff",
        "title": "Quick Account Handoff",
        "category": "Claude Session Bridge"
      },
      {
        "command": "claudeSessionBridge.diagnose",
        "title": "Diagnose Session Recovery",
        "category": "Claude Session Bridge"
      },
      {
        "command": "claudeSessionBridge.handoff",
        "title": "Hand Off Session to Another Account",
        "category": "Claude Session Bridge"
      },
      {
        "command": "claudeSessionBridge.finishHandoff",
        "title": "Finish Pending Handoff",
        "category": "Claude Session Bridge"
      },
      {
        "command": "claudeSessionBridge.resume",
        "title": "Resume Local Session",
        "category": "Claude Session Bridge"
      },
      {
        "command": "claudeSessionBridge.backup",
        "title": "Back Up Local Session",
        "category": "Claude Session Bridge"
      },
      {
        "command": "claudeSessionBridge.switchAccount",
        "title": "Switch Account Guide",
        "category": "Claude Session Bridge"
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/extension.js && node --check src/sessions.js && node --check src/handoff.js && node --check src/diagnostics.js && npm test",
    "package:vsix": "npx --yes @vscode/vsce@3.9.2 package --no-dependencies"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ehk2509/claude-session-bridge.git"
  },
  "type": "module",
  "icon": "media/icon.png"
}
